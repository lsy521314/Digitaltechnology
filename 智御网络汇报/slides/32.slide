    </Box>
    <Text style={{ position: 'absolute', left: 56, top: 62, fontFamily: 'Microsoft YaHei', fontSize: 31, fontWeight: 'bold', color: '#F2F7F8', letterSpacing: 0.5 }}>零信任微隔离：主机对主机</Text>
    <Text style={{ position: 'absolute', right: 56, top: 76, fontFamily: 'Consolas', fontSize: 10.5, color: '#6BC8D1' }}>TEACHING · ZERO TRUST</Text>

    <Box style={{ position: 'absolute', left: 56, top: 140, width: 512 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 10 }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 50, fontWeight: 'bold', color: 'rgba(107,200,209,0.55)', lineHeight: 1 }}>06</Text>
            <Text style={{ marginBottom: 5, fontFamily: 'Consolas', fontSize: 9, color: 'rgba(242,247,248,0.38)', letterSpacing: 1.2 }}>ZERO TRUST</Text>
        </Box>
        <Text style={{ marginTop: 14, fontFamily: 'Microsoft YaHei', fontSize: 23, fontWeight: 'bold', color: '#F2F7F8', lineHeight: 1.35 }}>取消“同区域即可信”，只保留必要的主机级放行</Text>
        <Box style={{ marginTop: 12, flexDirection: 'row', gap: 8 }}>
            <Box style={{ paddingLeft: 9, paddingRight: 9, paddingTop: 4, paddingBottom: 4, border: '1px solid rgba(231,129,114,0.28)', borderRadius: 3 }}>
