<Slide style={{ width: 1280, height: 720, background: '#07111B', padding: 0, position: 'relative', overflow: 'hidden' }}>
    <svg width={1280} height={720} viewBox='0 0 1280 720' style={{ position: 'absolute', left: 0, top: 0 }}>
        <g stroke='rgba(242,247,248,0.022)' strokeWidth='1'>
            <path d='M0 96H1280M0 192H1280M0 288H1280M0 384H1280M0 480H1280M0 576H1280M0 672H1280' />
        </g>
    </svg>

    <Box style={{ position: 'absolute', left: 56, top: 38 }}>
        <Text style={{ fontFamily: 'Consolas', fontSize: 11, color: '#6BC8D1', letterSpacing: 1.8 }}>SCENARIO 03 / 场景图集</Text>
    </Box>
    <Text style={{ position: 'absolute', left: 56, top: 62, fontFamily: 'Microsoft YaHei', fontSize: 31, fontWeight: 'bold', color: '#F2F7F8', letterSpacing: 0.5 }}>网络分区防御实验</Text>
    <Text style={{ position: 'absolute', right: 56, top: 76, fontFamily: 'Consolas', fontSize: 10.5, color: '#6BC8D1' }}>TEACHING · SEGMENTATION</Text>

    <Box style={{ position: 'absolute', left: 56, top: 140, width: 620 }}>
        <Image src="assets/scenario_segmentation.png" style={{ width: 620, height: 370, objectFit: 'cover', borderRadius: 8, border: '1px solid rgba(107,200,209,0.20)' }} />
        <Text style={{ marginTop: 9, fontFamily: 'Microsoft YaHei', fontSize: 10, color: 'rgba(242,247,248,0.42)' }}>真实界面 · 关闭错误放行后，办公区到数据库默认拒绝</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 712, top: 140, width: 512 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 10 }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 50, fontWeight: 'bold', color: 'rgba(107,200,209,0.55)', lineHeight: 1 }}>03</Text>
            <Text style={{ marginBottom: 5, fontFamily: 'Consolas', fontSize: 9, color: 'rgba(242,247,248,0.38)', letterSpacing: 1.2 }}>SEGMENTATION</Text>
        </Box>
        <Text style={{ marginTop: 14, fontFamily: 'Microsoft YaHei', fontSize: 23, fontWeight: 'bold', color: '#F2F7F8', lineHeight: 1.35 }}>分区不是“断开”，而是只留下必要路径</Text>
        <Box style={{ marginTop: 12, flexDirection: 'row', gap: 8 }}>
            <Box style={{ paddingLeft: 9, paddingRight: 9, paddingTop: 4, paddingBottom: 4, border: '1px solid rgba(242,247,248,0.14)', borderRadius: 3 }}>
                <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 9.5, color: 'rgba(242,247,248,0.60)' }}>进阶</Text>
            </Box>
            <Box style={{ paddingLeft: 9, paddingRight: 9, paddingTop: 4, paddingBottom: 4, border: '1px solid rgba(242,247,248,0.14)', borderRadius: 3 }}>
                <Text style={{ fontFamily: 'Consolas', fontSize: 9, color: 'rgba(242,247,248,0.60)' }}>6 MIN</Text>
            </Box>
            <Box style={{ paddingLeft: 9, paddingRight: 9, paddingTop: 4, paddingBottom: 4, border: '1px solid rgba(107,200,209,0.28)', borderRadius: 3 }}>
                <Text style={{ fontFamily: 'Consolas', fontSize: 9, color: '#6BC8D1' }}>TEACHING</Text>
            </Box>
        </Box>

        <Text style={{ marginTop: 18, fontFamily: 'Consolas', fontSize: 9, color: '#6BC8D1', letterSpacing: 1.2 }}>LEARNING OBJECTIVES</Text>
        <Text style={{ marginTop: 7, fontFamily: 'Microsoft YaHei', fontSize: 10.3, color: 'rgba(242,247,248,0.58)', lineHeight: 1.7 }}>· 理解 VLAN 与区域边界如何限制跨区通信</Text>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 10.3, color: 'rgba(242,247,248,0.58)', lineHeight: 1.7 }}>· 验证办公区到数据库的默认拒绝规则</Text>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 10.3, color: 'rgba(242,247,248,0.58)', lineHeight: 1.7 }}>· 确认必要 Web 与应用数据库业务仍可达</Text>

        <Text style={{ marginTop: 14, fontFamily: 'Consolas', fontSize: 9, color: '#6BC8D1', letterSpacing: 1.2 }}>WATCH FOR</Text>
        <Text style={{ marginTop: 7, fontFamily: 'Microsoft YaHei', fontSize: 10.3, color: 'rgba(242,247,248,0.58)', lineHeight: 1.7 }}>关闭“办公区错误放行数据库”后，Office → DB 被第 30 条拒绝；App → DB 仍走第 10 条放行。</Text>

        <Text style={{ marginTop: 14, fontFamily: 'Consolas', fontSize: 9, color: '#E78172', letterSpacing: 1.2 }}>TASK</Text>
        <Text style={{ marginTop: 7, fontFamily: 'Microsoft YaHei', fontSize: 10.3, color: 'rgba(242,247,248,0.58)', lineHeight: 1.7 }}>保护 Customer Database，同时保持办公 Web 与应用数据库两条业务可达。</Text>

        <Box style={{ marginTop: 12, flexDirection: 'row', gap: 7 }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.36)' }}>VLAN</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.20)' }}>/</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.36)' }}>区域边界</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.20)' }}>/</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.36)' }}>必要业务</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', left: 712, top: 540, width: 512, paddingTop: 12, borderTop: '1px solid rgba(107,200,209,0.22)' }}>
        <Text style={{ fontFamily: 'Consolas', fontSize: 9, color: '#6BC8D1', letterSpacing: 1.2 }}>DECISION PATH</Text>
        <Text style={{ marginTop: 6, fontFamily: 'Microsoft YaHei', fontSize: 10.2, color: 'rgba(242,247,248,0.54)', lineHeight: 1.7 }}>VLAN → 三层网关 → 区域策略 → 业务路径</Text>
