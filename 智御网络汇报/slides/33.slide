        <Text style={{ marginTop: 9, fontFamily: 'Microsoft YaHei', fontSize: 10, color: 'rgba(242,247,248,0.42)' }}>真实界面 · 挑战场景：控制中心、监控区、现场区与历史数据区</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 712, top: 140, width: 512 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 10 }}>
            <Text style={{ fontFamily: 'Consolas', fontSize: 50, fontWeight: 'bold', color: 'rgba(107,200,209,0.55)', lineHeight: 1 }}>07</Text>
