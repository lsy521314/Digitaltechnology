            <Text style={{ width: 30, fontFamily: 'Consolas', fontSize: 12, color: 'rgba(242,247,248,0.52)' }}>20</Text>
            <Box style={{ width: 54, paddingTop: 3, paddingBottom: 3, alignItems: 'center', background: 'rgba(242,247,248,0.06)', borderRadius: 3 }}>
                <Text style={{ fontFamily: 'Consolas', fontSize: 9, color: 'rgba(242,247,248,0.70)' }}>ALLOW</Text>
            </Box>
