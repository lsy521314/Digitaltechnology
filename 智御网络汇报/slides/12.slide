            </Box>
            <Box style={{ marginLeft: 10, width: 250 }}>
                <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 12, fontWeight: 'bold', color: '#F2F7F8' }}>应用服务 → 客户数据库</Text>
                <Text style={{ marginTop: 3, fontFamily: 'Consolas', fontSize: 9.5, color: 'rgba(242,247,248,0.48)' }}>DATABASE · 应用业务</Text>
