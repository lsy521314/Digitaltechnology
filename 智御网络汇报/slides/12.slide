                <Text style={{ marginTop: 3, fontFamily: 'Consolas', fontSize: 9.5, color: 'rgba(231,129,114,0.80)' }}>DATABASE · 顺序错误</Text>
            </Box>
        </Box>

        <Box style={{ marginTop: 8, height: 62, paddingLeft: 12, paddingRight: 12, flexDirection: 'row', alignItems: 'center', background: 'rgba(242,247,248,0.03)', border: '1px solid rgba(242,247,248,0.10)', borderRadius: 6 }}>
            <Text style={{ width: 30, fontFamily: 'Consolas', fontSize: 12, color: 'rgba(242,247,248,0.52)' }}>25</Text>
