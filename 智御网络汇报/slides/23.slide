    <Box style={{ position: 'absolute', left: 812, top: 146, width: 412 }}>
        <Box style={{ height: 90, borderTop: '1px solid rgba(242,247,248,0.10)' }}>
            <Text style={{ marginTop: 12, fontFamily: 'Consolas', fontSize: 9.5, color: '#6BC8D1' }}>01 / EDIT</Text>
