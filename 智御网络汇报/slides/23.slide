        </Box>
        <Box style={{ height: 90, borderTop: '1px solid rgba(242,247,248,0.10)' }}>
            <Text style={{ marginTop: 12, fontFamily: 'Consolas', fontSize: 9.5, color: '#6BC8D1' }}>02 / ORDER</Text>
            <Text style={{ marginTop: 5, fontFamily: 'Microsoft YaHei', fontSize: 13.5, fontWeight: 'bold', color: '#F2F7F8' }}>顺序可解释</Text>
            <Text style={{ marginTop: 4, fontFamily: 'Microsoft YaHei', fontSize: 10.2, color: 'rgba(242,247,248,0.54)', lineHeight: 1.65 }}>First Match：按 order 升序，第一条命中即生效；无命中时走 Default DENY。</Text>
        </Box>
        <Box style={{ height: 90, borderTop: '1px solid rgba(242,247,248,0.10)' }}>
            <Text style={{ marginTop: 12, fontFamily: 'Consolas', fontSize: 9.5, color: '#6BC8D1' }}>03 / TRACE</Text>
