            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.20)' }}>/</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.36)' }}>前置条件</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.20)' }}>/</Text>
            <Text style={{ fontFamily: 'Consolas', fontSize: 8.5, color: 'rgba(242,247,248,0.36)' }}>数据访问</Text>
