        <Text style={{ marginTop: 9, fontFamily: 'Microsoft YaHei', fontSize: 10, color: 'rgba(242,247,248,0.42)' }}>真实界面 · 核心实验：PC-01 → 应用服务 → 客户数据库</Text>
    </Box>

    <Box style={{ position: 'absolute', left: 712, top: 140, width: 512 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 10 }}>
