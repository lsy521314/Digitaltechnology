    <Box style={{ position: 'absolute', left: 390, top: 404, width: 834, height: 206, padding: 20, background: 'linear-gradient(145deg, rgba(231,129,114,0.05) 0%, rgba(242,247,248,0.02) 100%)', border: '1px solid rgba(231,129,114,0.18)', borderRadius: 10 }}>
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 17, fontWeight: 'bold', color: '#F2F7F8' }}>为什么 PC-01 直连数据库也不行？</Text>
